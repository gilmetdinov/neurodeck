# ─────────────────────────────────────────────────────────────
# neurodeck-agent — шаблон переменных окружения
# Скопируй в .env и заполни. .env в .gitignore, не коммитить.
#
# Эти переменные читаются:
#   1) скриптом scripts/deploy-config.sh при рендере openclaw.json
#   2) кастомным Redmine MCP-сервером (mcp-servers/redmine)
# OpenClaw сам подставляет ${VAR} в ~/.openclaw/openclaw.json из окружения
# демона (см. docs/guides/llm-setup.md, раздел про SecretRef).
# ─────────────────────────────────────────────────────────────

# === LLM — основной провайдер (OpenAI-совместимый) ===
# Получить ключ: https://platform.openai.com/api-keys  (см. docs/guides/llm-setup.md)
LLM_API_KEY=
# Базовый URL OpenAI-совместимого эндпоинта (менять не нужно)
LLM_BASE_URL=https://api.openai.com/v1
# ID модели оркестратора у провайдера. Также ФОЛБЭК для redmine-аналитика и ревьюера,
# если их свои модели (REDMINE_ANALYST_MODEL / REVIEW_MODEL ниже) не заданы.
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash

# === team_digest — агентный Redmine-аналитик (умный MCP-тул) ===
# Модель аналитика. Пусто → берётся LLM_MODEL. Сюда свопаешь на gemma и т.п.
# ⚠ модель ДОЛЖНА поддерживать function-calling (DeepSeek-V4-Pro — да; gemma проверь).
REDMINE_ANALYST_MODEL=deepseek-ai/DeepSeek-V4-Pro
# Температура аналитика (выше = свободнее/недетерминированнее интерпретация). Пусто → 0.6.
ANALYST_TEMPERATURE=0.6
# Поводок: макс. число внутренних шагов агента-аналитика (защита от фанаута). Пусто → 6.
ANALYST_MAX_STEPS=6

# === reviewer — code-review (умный MCP-тул review_mr, своя модель) ===
# Модель ревьюера. Пусто → берётся LLM_MODEL. Для ревью логична код-сильная модель.
# function-calling НЕ требуется (reviewer single-shot) — выбор моделей шире, чем у аналитика.
REVIEW_MODEL=deepseek-ai/DeepSeek-V4-Pro

# === compile_task — компилятор Redmine-задачи → черновик TaskSpec (умный MCP-тул, ADR-0015) ===
# Сильная модель опус-класса из LLM (ответ тимлида: «что-то мощное, на уровне опуса»).
# Пусто → фолбэк REDMINE_ANALYST_MODEL → LLM_MODEL. function-calling НЕ требуется (single-shot JSON).
COMPILER_MODEL=deepseek-ai/DeepSeek-V4-Pro
# Температура компилятора (ниже = детерминированнее структурный JSON). Пусто → 0.3.
COMPILER_TEMPERATURE=0.3

# === Gateway auth ===
# Токен gateway-auth (token-mode) — предусловие нативных апрувов. Генерится через
# `openclaw doctor` (Generate gateway token) → перенести сгенерённое значение СЮДА.
# Реальное значение НЕ коммитим (это .env, в .gitignore).
GATEWAY_AUTH_TOKEN=

# === Telegram Bot ===
# Токен от @BotFather (см. docs/guides/telegram-bot-setup.md)
TELEGRAM_BOT_TOKEN=
# Разрешённые пользователи в формате OpenClaw: telegram:<numeric_id>, через запятую.
# ВАЖНО: префикс именно telegram: (НЕ tg: — иначе бот молча проигнорит).
# Свой id узнать у @userinfobot. Пример: telegram:123456789
# Этот же список используется как commands.ownerAllowFrom (владелец).
TELEGRAM_ALLOWED_USER_IDS=
# Прокси. На этой машине OpenClaw требует прокси И для Telegram (гео), И для
# LLM (прямой большой POST виснет → ETIMEDOUT; через прокси отдаёт 200).
# scripts/run-gateway.sh по умолчанию гонит ВЕСЬ трафик через PROXY_URL
# (или TELEGRAM_PROXY как fallback). http://... или socks5://...
PROXY_URL=http://127.0.0.1:7897
# Доп. прокси именно для Telegram-канала в конфиге (channels.telegram.proxy).
# Можно оставить равным PROXY_URL; служит гарантией, что телега точно через прокси.
TELEGRAM_PROXY=http://127.0.0.1:7897

# === Redmine (этап 1+) ===
REDMINE_BASE_URL=https://your-redmine.example.com
# Аутентификация: API-ключ ИЛИ Basic Auth — заполни одно из двух.
REDMINE_API_KEY=
REDMINE_LOGIN=
REDMINE_PASSWORD=
# Дефолтный проект (slug) — скоуп для list_issues и аналитики. Реестр команды
# и семантика статусов/трекеров — в config/team.json.
REDMINE_PROJECT=

# === Redmine WRITE MCP (этап 4, ADR-0022) ===
# Прод-мутации (add_note/update_status/create_issue) за approval-гейтом. Учётка — пока та же
# (REDMINE_LOGIN/PASSWORD выше, NB-5: для тестов основная). Whitelist'ы/маппинг — config/redmine-write.json5.
# Подпись под примечанием (NB-3): по чьему поручению агент пишет. Пусто → «тимлида».
REDMINE_WRITE_ON_BEHALF=
# ВАЖНО: запись в прод включается флагом DRY_RUN=false (ниже, в Safety flags) — ТОЛЬКО после отладки
# гейта на тестовой задаче. Пока DRY_RUN=true → write-тулзы лишь логируют намерение (docs/approval-history.md).

# === GitLab Cloud (этап 2+) ===
GITLAB_BASE_URL=https://gitlab.com
# READ-токен (scope read_api + read_repository) — для gitlab-mr-mcp/reviewer.
GITLAB_TOKEN=

# === GitLab WRITE MCP (ADR-0025/0016) — релиз-менеджер + автоназначение ревью ===
# ОТДЕЛЬНЫЙ токен со scope `api` (write) — НЕ read GITLAB_TOKEN выше. merge_mr/set_reviewers за approval-гейтом.
# Whitelist веток/проектов/reviewer — config/gitlab-write.json5. Маппинг разрабов — config/team.json (gitlab.{username,id}).
# Подпись действия переиспользует REDMINE_WRITE_ON_BEHALF. Реальная запись — при DRY_RUN=false. Активация — docs/tasks/release-manager-activation.md.
GITLAB_WRITE_TOKEN=

# === Obsidian Vault (опционально) ===
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault
# Путь к корню Obsidian vault. MCP читает/пишет .md файлы относительно него.

# === Claude (Sub-Agent делегирование, опционально) ===
# Делегация идёт через подписку, НЕ через API-ключ. ANTHROPIC_API_KEY обычно не нужен.
# ANTHROPIC_API_KEY=
# Бинарь Claude Code — проксирующая обёртка.
CLAUDE_BIN=/path/to/claude

# === opencode / harness (опционально) ===
# Бинарь opencode.
OPENCODE_BIN=/path/to/opencode

# === Локальная модель (опционально, Qwen/vllm) ===
# Endpoint локальной модели.
LOCAL_MODEL_BASE_URL=http://localhost:8000
LOCAL_MODEL_API_KEY=
LOCAL_MODEL_NAME=qwen
LOCAL_MODEL_SMALL=qwen

# === Офисный RagFlow (ADR-0027 этап 5) ===
# База знаний: документация, стандарты, история задач. Используется компилятором
# и аналитиком для грунтовки. Пусто → rag_query отключён (без ошибок).
RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=

# === Figma MCP ===
# Персональный токен: Figma → Account Settings → Personal access tokens.
# Используется для чтения макетов и компиляции во фронтенд TaskSpec'ы.
FIGMA_TOKEN=
# Модель по умолчанию для Figma→frontend TaskSpec (opencode-go/ префикс).
FIGMA_DEFAULT_MODEL=opencode-go/kimi-k2.7-code

# === XWiki MCP (опционально) ===
XWIKI_BASE_URL=https://your-xwiki.example.com
XWIKI_WIKI=main
XWIKI_LOGIN=
XWIKI_PASSWORD=
XWIKI_PROXY=              # если нужен прокси

# (Настройки прокси — выше, переменная PROXY_URL. Запуск — scripts/run-gateway.sh.)

# === Safety flags ===
DRY_RUN=true               # true = только показывает что сделал бы, не пишет в prod
REQUIRE_APPROVAL=true      # true = всегда ждать Telegram-апрув перед write-операциями
MAX_TOKENS_PER_REQUEST=4096

# Включает РЕАЛЬНЫЙ запуск harness-прогонов (run_task/run_batch) — тратит $/подписку Claude.
# Пусто/0 = ОТКЛЮЧЕНО (preview/status/list работают). 1 = включить. Запуск ВСЁ РАВНО гейтится
# апрувом-кнопкой (плагин approval-gate), так что 1 безопасно: каждый прогон требует кнопки.
HARNESS_RUN_ENABLED=

# === Executor-engine (ADR-0026/0027) [deprecated, заменён на Worker Pool ADR-0028] ===
# Интервал поллинга новых задач (статус 20 «На исполнение»). Дефолт 30 мин.
EXECUTOR_POLL_INTERVAL_MS=1800000
# Интервал поллинга доработок (статус 8 «На доработке»). Дефолт 15 мин.
EXECUTOR_REWORK_POLL_INTERVAL_MS=900000
# Таймаут компилятора (LLM). Дефолт 120с.
COMPILER_TIMEOUT_MS=120000
# Кулдаун повторного анонса задач на апрув. Дефолт 5 мин.
EXECUTOR_ANNOUNCE_COOLDOWN_MS=300000

# === Worker Pool (ADR-0028) ===
# Интервал поллинга новых задач Task Poller. Дефолт 1 мин.
TASK_POLLER_INTERVAL_MS=60000
# Интервал поллинга доработок Task Poller. Дефолт 15 мин.
TASK_POLLER_REWORK_INTERVAL_MS=900000
# Redmine agent account ID. Дефолт 386.
TASK_POLLER_AGENT_ID=386
# Worker ID (worker-1 по умолчанию). Менять при запуске второго worker.
WORKER_ID=worker-1
# Интервал опроса очереди Agent Worker. Дефолт 30 сек.
AGENT_WORKER_POLL_INTERVAL_MS=30000
# Интервал heartbeat Agent Worker. Дефолт 30 сек.
AGENT_WORKER_HEARTBEAT_INTERVAL_MS=30000
# Таймаут harness-прогона. Дефолт 2 часа.
HARNESS_TIMEOUT_MS=7200000
# Chat ID для Notifier (групповой чат разрабов в Telegram). Узнать у @getidsbot.
NOTIFIER_CHAT_ID=

# === Worker Pool (ADR-0028) — локальные пути ===
# Базовая директория проектов (аналог baseDir в config/projects.json5).
# Используется для обнаружения репо через workRoots (services/, libraries/ и т.д.).
AGENT_WORKBENCH_DIR=
# Базовая директория для изолированных клонов worker pool.
CLONES_BASE_DIR=
